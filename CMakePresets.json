{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Debug, Host)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug-host"
    },
    {
      "name": "switch",
      "displayName": "Nintendo Switch (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug-devkita64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/Switch.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "switch-release",
      "displayName": "Nintendo Switch (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release-devkita64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/Switch.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "switch",
      "configurePreset": "switch"
    },
    {
      "name": "switch-release",
      "configurePreset": "switch-release"
    }
  ]
}

